<ModInfo extended="true"> 
<!-- extended="true" is the basic marker required for extended loader to postprocess the xml -->
<!-- some of the following features will probably not be needed for you - feel free to remove those -->
  <FaceInfo>
    <!-- all content here will read at its original size -->
    <Front_FrontHair>Front_FrontHair</Front_FrontHair>
    <Front_RearHair>Front_RearHair</Front_RearHair>
    <Front_Mouth_Normal>Front_Mouth_Normal</Front_Mouth_Normal>
    <Front_Mouth_Attack>Front_Mouth_Attack</Front_Mouth_Attack>
    <Front_Mouth_Hit>Front_Mouth_Hit</Front_Mouth_Hit>
    <Front_Brow_Normal>Front_Brow_Normal</Front_Brow_Normal>
    <Front_Brow_Attack>Front_Brow_Attack</Front_Brow_Attack>
    <Front_Brow_Hit>Front_Brow_Hit</Front_Brow_Hit>
    <Side_FrontHair>Side_FrontHair</Side_FrontHair>
    <Side_RearHair_Front>Side_RearHair</Side_RearHair_Front>
    <Side_RearHair_Rear>Side_RearHair</Side_RearHair_Rear>
    <Front_Eye>Front_Eye</Front_Eye>
    <Side_Eye>Side_Eye</Side_Eye>
  </FaceInfo>
  <!-- if character using this skin has IsCustomizable == false (for enemies that means RandomFace == false), load this customization data instead -->
  <ExtendedFaceInfo>
    <!-- if you want to reuse the same hair/eye/etc for multiple enemies, put files and names into one xml, then just same names into another -->
    <!-- you can also use numbers here, if you want to load vanilla customs (0-42 front hair, 0-22 back hair, 0-31 eye, 0-13 brow, 0-13 mouth)-->
    <FrontHair>modid_mycustom</FrontHair>
    <RearHair>modid_mycustom</RearHair>
    <Eye>modid_mycustom</Eye>
    <Brow>modid_mycustom</Brow>
    <Mouth>modid_mycustom</Mouth>
    <!-- this is just for customization data to load -->
    <!-- for supported color formats see ColorUtility.TryParseHtmlString -->
    <HairColor>cyan</HairColor>
    <EyeColor>black</EyeColor>
    <SkinColor>#97BBB1</SkinColor>
    <!-- you can add custom gifts using <Gift[GiftPosition]> -->
    <!-- this will be given with SetTemporaryGift(ResName, Position), so most vanilla gifts will not work -->
    <!-- but custom gifts made with Basemod/ExtraBridge or similar custom resource parsers will -->
    <GiftEye>Gift_Custom_SomeName</GiftEye> <!-- for basemod resname -->
	<GiftNose>Gift_ExtraBridge_SomeName</GiftNose> <!-- for extrabridge resname -->
	<!-- for any other custom gift loaders configure this according to their resname parsing logic -->
  </ExtendedFaceInfo>
  <ClothInfo>
    <Name>MySkin</Name>
    <!-- Fill in the size (resolution) and quality (pixels per game world distance unit) you want your character image to be scaled to -->
    <!-- if not filled in, default size is 512x512 (can be changed to native image size for all motions by putting size_dynamic="true" into ClothInfo) -->
    <!-- if not filled in, default quality is 50 (can be changed to same value for all motions by putting quality into ClothInfo) -->
    <!-- note that quality influences the scale of character images -->
    <!-- the following skin layers (file names) are supported: 
        Motion                  (or Motion_mid)                    -  default layer - under head but over rear hair
        Motion_skin             (or Motion_mid_skin)               -  just over default layer (but still under head), will be colored or disabled according to customization
        Motion_front                                               -  default front layer - over head
        Motion_front_skin                                          -  just over default front layer, will be colored or disabled according to customization
        Motion_rear             (or Motion if Motion_mid exists)   -  new rearmost layer - under rear hair
        Motion_rear_skin   (or Motion_skin if Motion_mid exists)   -  over rearmost layer (but still under rear hair), will be colored or disabled according to customization
        Motion_effect                                              -  set to Effect layer (over the rest of the skin)
    -->
    <Default size_x="1330" size_y="1330" quality="50">
      <Direction>Front</Direction>
      <Pivot pivot_x="-34.58" pivot_y="-619.78" />
      <Head head_x="0" head_y="0" rotation="0" head_enable="False" />
      <!-- if head enabled, can also use complex format (see below) -->
      
      <!-- the following will be stored in additionalPivotList in CharacterMotion, to be used by custom scripts if needed -->
      <!-- see e.g. Distorted Yan's chain attachment points -->
      <AdditionalPivot x="80" y="200" rotation="30" /> <!-- simple format -->
      <AdditionalPivot>
        <!-- complex format (note that position in complex format is 1/100 of simple format) -->
        <localPosition x="0.8" y="2" z="0"/> <!-- Position -->
        <localScale x="1" y="1" z="1"/> <!-- Scale -->
        <localEulerAngles x="0" y="0" z="30"/> <!-- Rotation -->
      </AdditionalPivot>
    </Default>
